{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema-registry/statecraft-intake-sidecar.v1.json",
  "title": "Statecraft intake queue sidecar (non-canonical runtime artifact)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_path",
    "pub_date",
    "synthesis_status",
    "rated_at",
    "non_canonical"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "statecraft-intake-sidecar.v1"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "pub_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "synthesis_status": {
      "type": "string",
      "enum": ["new", "queued", "daily", "discarded"]
    },
    "rated_at": {
      "type": "string",
      "minLength": 1
    },
    "non_canonical": {
      "type": "boolean",
      "const": true
    },
    "source_url": {
      "type": ["string", "null"]
    },
    "actors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "regions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mechanisms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "strategic_relevance": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "transaction_candidate": {
      "type": ["boolean", "null"]
    },
    "reasoning": {
      "type": ["string", "null"]
    },
    "digest_rank": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
