{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/statecraft/event.schema.json",
  "title": "Event registry entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["question", "resolution_criteria", "status"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "resolution_criteria": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["open", "resolved", "void", "deprecated"]
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["yes", "no", null]
    },
    "category": { "type": "string" },
    "start_date": { "type": ["string", "null"] },
    "close_date": { "type": ["string", "null"] },
    "resolved_date": { "type": ["string", "null"] },
    "resolution_source": { "type": ["string", "null"] },
    "horizon_type": { "type": ["string", "null"] },
    "horizon_cite": { "type": ["string", "null"] },
    "closure_trigger": { "type": ["string", "null"] },
    "falsifier": { "type": "string" },
    "falsifier_model": {
      "type": "object",
      "properties": {
        "failure_modes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "condition", "probability"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "condition": { "type": "string", "minLength": 1 },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "confidence_distribution": { "type": "string" },
        "inference_source": { "enum": ["heuristic_v1", "operator"] },
        "entropy": { "type": "number" }
      }
    }
  }
}
