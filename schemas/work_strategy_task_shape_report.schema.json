{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grace-mar.local/schemas/work_strategy_task_shape_report.schema.json",
  "title": "WorkStrategyTaskShapeReport",
  "description": "Derived task-shape classification from classify_task_shape.py — ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_family",
    "receipt_kind",
    "run_id",
    "created_at",
    "lane",
    "actor",
    "intent",
    "authority_class",
    "resources_read",
    "resources_written",
    "status",
    "review_surface",
    "rollback_surface",
    "record_authority",
    "gate_effect",
    "input",
    "classification",
    "shape_contract",
    "record_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "work-strategy-task-shape-report.v1"
    },
    "receipt_family": {
      "type": "string",
      "const": "inspection"
    },
    "receipt_kind": {
      "type": "string",
      "const": "work-strategy-task-shape-report"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "const": "work-strategy" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "type": "string", "const": "script" },
        "id": { "type": "string", "const": "scripts/work_strategy/classify_task_shape.py" },
        "label": { "type": "string", "const": "classify_task_shape" }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "const": "work_operator"
    },
    "resources_read": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resources_written": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "needs_review"]
    },
    "review_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "paths", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "task_shape_report" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "rollback_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "rerun_or_replace" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "record_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "gate_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "snippet_ready", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "snippet_ready": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "task_path": { "type": ["string", "null"] },
        "inline_text_provided": { "type": "boolean" },
        "source_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "config_path": { "type": "string" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_shape",
        "confidence",
        "matched_signals",
        "secondary_candidates",
        "notes"
      ],
      "properties": {
        "primary_shape": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "matched_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shape", "score"],
            "properties": {
              "shape": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "shape_contract": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validator_emphasis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_posture": { "type": "string" }
      }
    },
    "record_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_paths_written", "canonical_write_violation", "notes"],
      "properties": {
        "canonical_paths_written": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical_write_violation": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
