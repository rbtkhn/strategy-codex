{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/singularity/loop.schema.json",
  "title": "Singularity loop definition",
  "type": "object",
  "required": ["loop"],
  "additionalProperties": false,
  "properties": {
    "loop": {
      "type": "object",
      "required": ["id", "category", "trigger", "inputs", "process", "outputs", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "category": {
          "enum": ["projects", "business", "research", "personal"]
        },
        "trigger": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": {
              "enum": ["event", "time", "manual"]
            },
            "schedule": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "process": {
          "type": "object",
          "required": ["steps"],
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["description"],
                "additionalProperties": false,
                "properties": {
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "state": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["active", "paused", "completed"]
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["loop_id"],
            "additionalProperties": false,
            "properties": {
              "loop_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "last_run": {
          "type": ["string", "null"]
        },
        "output_shelves": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
