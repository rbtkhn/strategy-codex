{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/singularity/moonshots-intelligence.schema.json",
  "title": "Moonshots intelligence document",
  "type": "object",
  "required": [
    "schema_version",
    "core_thesis",
    "bullets",
    "concept_primitives",
    "feedback_loops",
    "meta_insight",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "core_thesis": { "type": "string", "minLength": 1 },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bullet" }
    },
    "concept_primitives": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "feedback_loops": {
      "type": "object",
      "required": ["reinforcing", "balancing"],
      "additionalProperties": false,
      "properties": {
        "reinforcing": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "balancing": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "meta_insight": { "type": "string", "minLength": 1 },
    "nst_mapping": {
      "type": "array",
      "items": { "$ref": "#/$defs/nst_entry" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "required": ["claim", "mechanism", "implication", "evidence_ref", "evidence"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "implication": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "pattern": "^E[0-9]+$" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "nst_entry": {
      "type": "object",
      "required": ["evidence_ref", "object_claim", "morphism_mechanism", "functor_implication", "ground_anchor"],
      "additionalProperties": false,
      "properties": {
        "evidence_ref": { "type": "string", "pattern": "^E[0-9]+$" },
        "object_claim": { "type": "string", "minLength": 1 },
        "morphism_mechanism": { "type": "string", "minLength": 1 },
        "functor_implication": { "type": "string", "minLength": 1 },
        "ground_anchor": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "archive_path",
        "output_basename",
        "compiler_version",
        "prompt_id",
        "generated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "archive_path": { "type": "string", "minLength": 1 },
        "output_basename": { "type": "string", "minLength": 1 },
        "episode_number": { "type": ["integer", "null"] },
        "episode_type": { "type": "string" },
        "source_url": { "type": "string" },
        "slug": { "type": "string" },
        "compiler_version": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_hash": { "type": ["string", "null"] },
        "model": { "type": "string" },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
