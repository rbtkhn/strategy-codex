{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grace-mar.local/schemas/work_strategy_carry_receipt.schema.json",
  "title": "WorkStrategyCarryReceipt",
  "description": "Derived receipt from run_carry_harness.py — WORK-only; not Record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_family",
    "receipt_kind",
    "run_id",
    "created_at",
    "lane",
    "actor",
    "intent",
    "authority_class",
    "resources_read",
    "resources_written",
    "status",
    "review_surface",
    "rollback_surface",
    "record_authority",
    "gate_effect",
    "harness",
    "input",
    "expected_artifacts",
    "observed_artifacts",
    "checks",
    "summary",
    "gate_snippet",
    "record_boundary",
    "result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "work-strategy-carry-receipt.v1"
    },
    "receipt_family": {
      "type": "string",
      "const": "execution"
    },
    "receipt_kind": {
      "type": "string",
      "const": "work-strategy-carry-receipt"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "const": "work-strategy" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "type": "string", "const": "script" },
        "id": { "type": "string", "const": "scripts/work_strategy/run_carry_harness.py" },
        "label": { "type": "string", "const": "run_carry_harness" }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "const": "work_operator"
    },
    "resources_read": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resources_written": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "review_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "paths", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "receipt_json" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "rollback_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "rerun_or_replace" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "record_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "gate_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "snippet_ready", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "snippet_ready": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "run_carry_harness" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_title": { "type": "string" },
        "task_path": { "type": ["string", "null"] },
        "task_text_preview": { "type": "string" },
        "source_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gate_snippet_path": { "type": ["string", "null"] }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observed_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "word_count": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "details"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "needs_review"]
          },
          "details": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "needs_review", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "needs_review"]
        },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "gate_snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "text", "notes"],
      "properties": {
        "ready": { "type": "boolean" },
        "text": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "record_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_paths_written", "canonical_write_violation", "notes"],
      "properties": {
        "canonical_paths_written": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical_write_violation": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "validation_report_path": {
      "type": ["string", "null"],
      "description": "Relative repo path where validation JSON was written when --run-validators wrote a report."
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "needs_review", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "needs_review"]
        },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "task_shape_report_path": { "type": ["string", "null"] },
    "task_shape": { "type": ["string", "null"] },
    "task_shape_confidence": {
      "type": ["string", "null"]
    },
    "task_shape_expected_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_packet_path": {
      "type": ["string", "null"],
      "description": "Relative repo path where review packet JSON was written when --build-review-packet wrote a file."
    },
    "review_packet_markdown_path": {
      "type": ["string", "null"],
      "description": "Relative repo path where review packet Markdown was written when --review-packet-markdown was set and allowed."
    },
    "review_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "needs_review", "fail"]
        },
        "reason": { "type": "string" }
      }
    },
    "arc_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "arc_movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movement_type", "summary", "evidence"],
      "properties": {
        "movement_type": {
          "type": "string",
          "enum": ["reinforces", "updates", "weakens", "opens", "closes", "mixed"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
