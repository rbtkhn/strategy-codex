{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grace-mar.local/schemas/work_strategy_validation_report.schema.json",
  "title": "WorkStrategyValidationReport",
  "description": "Derived validation report from validate_strategy_packet.py — ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_family",
    "receipt_kind",
    "run_id",
    "created_at",
    "lane",
    "actor",
    "intent",
    "authority_class",
    "resources_read",
    "resources_written",
    "status",
    "review_surface",
    "rollback_surface",
    "record_authority",
    "gate_effect",
    "target",
    "validators",
    "summary",
    "record_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "work-strategy-validation-report.v1"
    },
    "receipt_family": {
      "type": "string",
      "const": "inspection"
    },
    "receipt_kind": {
      "type": "string",
      "const": "work-strategy-validation-report"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "const": "work-strategy" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "type": "string", "const": "script" },
        "id": { "type": "string", "const": "scripts/work_strategy/validate_strategy_packet.py" },
        "label": { "type": "string", "const": "validate_strategy_packet" }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "const": "work_operator"
    },
    "resources_read": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resources_written": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "review_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "paths", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "validation_report" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "rollback_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "notes"],
      "properties": {
        "primary": { "type": "string", "const": "rerun_or_replace" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "record_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "gate_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "snippet_ready", "notes"],
      "properties": {
        "class": { "type": "string", "const": "none" },
        "snippet_ready": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "task": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtime/artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gate_snippet": { "type": ["string", "null"] },
        "validation_out": { "type": ["string", "null"] }
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "details", "subject_paths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "needs_review"]
          },
          "details": { "type": "string" },
          "subject_paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "needs_review", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "needs_review"]
        },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "record_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_paths_written", "canonical_write_violation", "notes"],
      "properties": {
        "canonical_paths_written": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical_write_violation": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "task_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_shape", "notes"],
      "properties": {
        "primary_shape": { "type": "string", "minLength": 1 },
        "confidence": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
