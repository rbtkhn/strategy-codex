{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/runtime/epistemic-intelligence-events.schema.json",
  "title": "Epistemic Intelligence Core event rollup",
  "type": "object",
  "required": ["_meta", "interpretation", "events"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["generated", "do_not_edit", "source"],
      "properties": {
        "generated": { "type": "boolean" },
        "do_not_edit": { "type": "boolean" },
        "source": { "type": "string" },
        "phase": { "type": "string" },
        "eic_source": { "type": "string", "enum": ["heuristic_v1"] }
      },
      "additionalProperties": true
    },
    "interpretation": { "type": "string", "enum": ["epistemic_intelligence_events"] },
    "events": { "type": "object" }
  }
}
