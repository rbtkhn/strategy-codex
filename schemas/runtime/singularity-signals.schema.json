{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/runtime/singularity-signals.schema.json",
  "title": "Singularity orchestrator signals",
  "type": "object",
  "required": ["_meta", "pending_loops", "blocked_loops", "attention_required"],
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["generated", "do_not_edit", "source"],
      "properties": {
        "generated": { "type": "boolean" },
        "do_not_edit": { "type": "boolean" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "pending_loops": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked_loops": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attention_required": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
