{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/runtime/event-alignment-map.schema.json",
  "title": "Event alignment map artifact",
  "type": "object",
  "required": ["_meta", "interpretation", "matched", "unmatched", "stats"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["generated", "do_not_edit", "source", "registry_mutation"],
      "properties": {
        "generated": { "type": "boolean" },
        "do_not_edit": { "type": "boolean" },
        "source": { "type": "string" },
        "phase": { "type": "string" },
        "extraction_source": { "type": "string", "enum": ["heuristic_v1"] },
        "registry_mutation": { "type": "boolean", "const": false }
      },
      "additionalProperties": true
    },
    "interpretation": { "type": "string", "enum": ["event_alignment_audit"] },
    "matched": { "type": "array" },
    "unmatched": { "type": "array" },
    "stats": {
      "type": "object",
      "required": ["claim_count", "matched_count", "unmatched_count"],
      "properties": {
        "claim_count": { "type": "integer", "minimum": 0 },
        "matched_count": { "type": "integer", "minimum": 0 },
        "unmatched_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
