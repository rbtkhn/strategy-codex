{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/runtime/multivoice-extracted-dataset.schema.json",
  "title": "Multivoice extracted dataset artifact",
  "type": "object",
  "required": ["_meta", "interpretation", "trajectories"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "generated",
        "do_not_edit",
        "source",
        "extraction_source",
        "claim_source",
        "registry_mutation",
        "voices",
        "extraction_scope"
      ],
      "properties": {
        "generated": { "type": "boolean" },
        "do_not_edit": { "type": "boolean" },
        "source": { "type": "string" },
        "phase": { "type": "string" },
        "extraction_source": { "type": "string", "enum": ["heuristic_v1"] },
        "claim_source": { "type": "string", "enum": ["capture_map"] },
        "registry_mutation": { "type": "boolean", "const": false },
        "voices": { "type": "array", "items": { "type": "string" } },
        "low_n_advisory": { "type": "boolean" },
        "extraction_scope": { "type": "object" }
      },
      "additionalProperties": true
    },
    "interpretation": { "type": "string", "enum": ["multivoice_extraction"] },
    "trajectories": {
      "type": "array",
      "items": { "$ref": "#/$defs/trajectoryBlock" }
    }
  },
  "$defs": {
    "trajectoryPoint": {
      "type": "object",
      "required": ["timestamp", "claim", "stance", "probability", "confidence"],
      "properties": {
        "timestamp": { "type": "string" },
        "claim": { "type": "string" },
        "stance": { "type": "string" },
        "probability": { "type": "number" },
        "confidence": { "type": "number" }
      }
    },
    "trajectoryBlock": {
      "type": "object",
      "required": ["event_id", "voice", "trajectory", "alignment_score"],
      "properties": {
        "event_id": { "type": "string" },
        "voice": { "type": "string" },
        "trajectory": {
          "type": "array",
          "items": { "$ref": "#/$defs/trajectoryPoint" }
        },
        "alignment_score": { "type": "number" },
        "entropy_weighted_probability": { "type": "number" }
      }
    }
  }
}
